# Direccion del stream HLS que reproduce la pagina (MediaMTX)
STREAM_URL=http://localhost:8888/live/stream/index.m3u8

# Delay del video en segundos (cuanto se atrasa respecto al directo)
VIDEO_DELAY=5

# Lista de emojis de la lluvia (JSON)
EMOJIS=["🔥","😍","😂","👍","❤️","😮","👏","😭","🎉","🙌","💯","🤩"]

# Cantidad maxima de emojis simultaneos
MAX_EMOJIS=10

# (Opcional) URL WHIP fija. Vacio usa http://<host>:3000/whip automaticamente
WHIP_URL=
